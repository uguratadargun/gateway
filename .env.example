# Required: long random string used to encrypt stored OAuth tokens at rest.
# Generate with: openssl rand -hex 32
GATE_SECRET=

# Required: admin secret for the dashboard / management API login.
# Generate with: openssl rand -hex 24
GATE_ADMIN_SECRET=

# Optional: require this key on gateway requests (Authorization: Bearer <key>)
# when no keys have been issued from the dashboard. Leave empty for local-only.
GATE_API_KEY=

# The server binds to 127.0.0.1 by default. To expose on your LAN use
# `npm run dev:lan` / `npm run start:lan` (the admin login still protects it).

# Optional overrides (defaults match the installed Claude Code CLI).
# CLAUDE_OAUTH_CLIENT_ID=
# CLAUDE_OAUTH_REDIRECT_URI=https://platform.claude.com/oauth/code/callback
# CLAUDE_CODE_VERSION=2.1.259
# CLAUDE_CODE_STAINLESS_VERSION=0.112.1

# Optional: where gate stores its SQLite DB, credentials, and config (default ~/.gate).
# GATE_HOME=
# GATE_ROUTING_FILE=
