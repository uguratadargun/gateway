# Required: long random string used to seal provider API keys at rest.
# Generate with: openssl rand -hex 32
GATE_SECRET=

# Required: admin secret for the dashboard / management API login.
# Generate with: openssl rand -hex 24
GATE_ADMIN_SECRET=

# Optional: a key the client API accepts when no keys have been issued from the
# dashboard; it answers as the default team.
GATE_API_KEY=

# The server binds to 127.0.0.1 by default. To expose on your LAN use
# `npm run dev:lan` / `npm run start:lan` (the admin login still protects it).

# Optional: where gate stores its SQLite DB and config (default ~/.gate).
# GATE_HOME=
# Where a new machine fetches the gate plugin from: a GitHub owner/repo or the
# git URL of a mirror of this repository. Also editable on the Settings page.
# GATE_PLUGIN_SOURCE=uguratadargun/gateway
